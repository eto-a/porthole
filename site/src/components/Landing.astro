<script>
  const copy = async (btn: HTMLButtonElement, text: string) => {
    try {
      await navigator.clipboard.writeText(text);
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Press Ctrl+C';
    }
    setTimeout(() => (btn.textContent = 'Copy'), 1800);
  };

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', () => copy(b, b.dataset.copy ?? ''));
  });

  // Terminals: copy the commands of the visible tab, without prompts, comments' prompts and output.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-term]').forEach((b) => {
    b.addEventListener('click', () => {
      const root = b.closest('.term') as HTMLElement;
      const panel = root.querySelector<HTMLElement>('[role=tabpanel]:not([hidden])') ?? root;
      const lines = [...panel.querySelectorAll<HTMLElement>('.l.c, .l.k')].map((l) => l.textContent ?? '');
      copy(b, lines.join('\n'));
    });
  });

  document.querySelectorAll<HTMLElement>('[data-term]').forEach((term) => {
    const tabs = [...term.querySelectorAll<HTMLButtonElement>('[role=tab]')];
    const title = term.querySelector('[data-term-title]');
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
      if (title) title.textContent = tab.dataset.title ?? '';
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (dir) {
          e.preventDefault();
          select(tabs[(i + dir + tabs.length) % tabs.length], true);
        }
      });
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-dismiss]').forEach((b) => {
    b.addEventListener('click', () => {
      const el = document.getElementById(b.dataset.dismiss ?? '');
      if (el) el.hidden = true;
      try {
        localStorage.setItem('porthole-banner-v0.4', '1');
      } catch {
        // storage unavailable: the banner returns on the next visit
      }
    });
  });
</script>

