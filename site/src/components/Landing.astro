---
import { Icon } from '@astrojs/starlight/components';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { base, repoUrl, version } from '../../site.config.mjs';

const doc = (p: string) => `${base}/docs/${p}`;
const install = 'curl -fsSL https://raw.githubusercontent.com/eto-a/porthole/main/install.sh | sh';
const agentPrompt =
  "Set up porthole for me: follow https://raw.githubusercontent.com/eto-a/porthole/main/docs/agent-install.md — ask me only what you can't find out yourself.";

/**
 * Terminal lines. Kinds: c command (copied), k continuation of a command (copied), o output, m comment,
 * u what the user types to the agent, a tool call of the agent, r result of a tool call, f file content, b blank.
 */
type Line = [kind: 'c' | 'k' | 'o' | 'm' | 'u' | 'a' | 'r' | 'f' | 'b', text: string];
const tabs: { id: string; label: string; title: string; lines: Line[] }[] = [
  {
    id: 'agent',
    label: 'Agent',
    title: 'claude: porthole',
    lines: [
      ['m', '# once: connect Claude Code to your server'],
      ['c', 'claude mcp add --transport http porthole \\'],
      ['k', 'https://tun.example.com/_porthole/mcp \\'],
      ['k', '--header "Authorization: Bearer ph_..."'],
      ['b', ''],
      ['u', 'expose port 8080 on home'],
      ['a', 'request_tunnel {client: "home", kind: "http", local_addr: "8080"}'],
      ['r', 'https://http-8080-home.tun.example.com'],
      ['u', 'what hit my webhook in the last 10 minutes?'],
      ['a', 'query_requests {since: "10m"}'],
      ['u', 'add my new laptop'],
      ['a', 'create_join_link {client: "laptop"}'],
      ['r', 'porthole join https://tun.example.com/j/pj_3kq9w2m1z8xa_...'],
    ],
  },
  {
    id: 'https',
    label: 'HTTPS',
    title: 'bash: home',
    lines: [
      ['c', install],
      ['c', 'porthole join https://tun.example.com/j/pj_3kq9w2m1z8xa_...'],
      ['c', 'porthole http 3000'],
      ['o', 'connected as home'],
      ['o', 'https://http-3000-home.tun.example.com -> 127.0.0.1:3000'],
    ],
  },
  {
    id: 'ssh',
    label: 'SSH',
    title: 'bash: ssh by name',
    lines: [
      ['m', '# on the machine behind NAT (it needs an sshd)'],
      ['c', 'porthole ssh'],
      ['b', ''],
      ['m', '# anywhere else, with stock OpenSSH'],
      ['c', 'ssh -J tun.example.com:2222 alice@home'],
    ],
  },
  {
    id: 'tcp',
    label: 'TCP',
    title: 'bash: tcp',
    lines: [
      ['m', '# a database or any TCP service, on a port of the server'],
      ['c', 'porthole tcp 5432'],
      ['c', 'porthole tcp nas.local:5432 --remote-port 20017'],
    ],
  },
  {
    id: 'daemon',
    label: 'Daemon',
    title: 'bash: tunnels that survive reboots',
    lines: [
      ['f', '# tunnels.yaml'],
      ['f', 'version: 1'],
      ['f', 'tunnels:'],
      ['f', '  blog: {type: http, addr: 3000}'],
      ['f', '  db:   {type: tcp, addr: "nas.local:5432"}'],
      ['f', '  ssh:  {type: ssh}'],
      ['b', ''],
      ['c', 'sudo systemctl enable --now porthole'],
      ['c', 'porthole status'],
    ],
  },
];

const chips = [
  'MCP server built in',
  'Agent opens tunnels on request',
  'Join links, no secrets in the chat',
  'Traffic log and inspector for the agent',
  'SSH by name',
];

const agentPoints = [
  {
    h: 'Two MCP surfaces',
    t: 'An operator MCP server on your server (`/_porthole/mcp` over HTTP, or `portholed mcp` over stdio) and `porthole mcp` on a machine. Works with Claude Code and any MCP client.',
  },
  {
    h: 'Scopes, toolsets, read-only',
    t: 'A bearer token carries only the scopes you give it. `--toolsets` picks tools and `--read-only` registers no mutating tool at all. Every mutating call, refusals included, goes to the audit log.',
  },
  {
    h: 'Join links, not secrets',
    t: '`create_join_link` returns a single-use link, valid 15 minutes. The permanent token goes straight to the new machine and never passes through the conversation.',
  },
  {
    h: 'Remote tunnel requests',
    t: '`request_tunnel` asks a connected machine to open a tunnel. The machine has the last word: by default only its own loopback ports, anything else only if listed in `allow_remote`.',
  },
  {
    h: 'No MCP? Use the CLI',
    t: '`--json` prints JSON (JSON Lines for long-running commands) with stable exit codes, so any agent can script `porthole http 8080 --detach --json`.',
  },
];

const tools = [
  'server_status',
  'list_clients',
  'list_tunnels',
  'request_tunnel',
  'close_tunnel',
  'create_join_link',
  'list_tokens',
  'query_requests',
  'get_request',
  'replay_request',
  'connection_log',
  'audit_log',
];

const capabilities = [
  {
    h: 'HTTPS tunnels',
    t: 'Expose localhost to the internet: share a local web server at its own subdomain. HTTP(S) and WebSocket, with automatic Let\'s Encrypt certificates and no DNS provider to configure.',
    code: 'porthole http 3000',
    href: doc('quickstart/'),
  },
  {
    h: 'SSH by name',
    t: 'SSH into a computer behind NAT with stock OpenSSH and nothing installed on the machine you connect from. `scp`, `sftp` and `rsync` work too.',
    code: 'ssh -J tun.example.com:2222 alice@home',
    href: doc('ssh/'),
  },
  {
    h: 'TCP services',
    t: 'Publish a database, a game server or anything else on a port of your server\'s range. The port stays reserved for the tunnel for 24 hours.',
    code: 'porthole tcp 5432',
    href: doc('recipes/'),
  },
];

const why = [
  { h: 'You own the server, domain and data', t: 'A tunnel from your own VPS. No account with a third party, nothing leaves your machines.', href: doc('server/') },
  { h: 'No metering', t: 'No plans, no request caps, no bandwidth bills. The limits are yours to set.', href: doc('faq/') },
  { h: 'Works behind NAT', t: 'The client only makes one outbound TLS connection on port 443, so it passes NAT and most corporate firewalls.', href: doc('client/') },
  { h: 'Tokens with scopes and expiry', t: 'Created, listed and revoked on the server. Revocation applies to live sessions.', href: doc('server/#tokens') },
  { h: 'Stable addresses', t: 'HTTP names come from the tunnel name; TCP ports stay reserved for 24 hours, also across server restarts.', href: doc('server/#tcp-ports-and-reservations') },
  { h: 'Signed releases and SBOMs', t: 'Signed with cosign, with build provenance attestations and SBOMs you can verify.', href: doc('install/#verifying-a-download') },
];

const compare = [
  { h: 'Choose ngrok', t: 'if you want a hosted service and do not want to run a server at all. The server side is ngrok&rsquo;s.' },
  {
    h: 'Choose Cloudflare Tunnel',
    t: 'if your domain is already on Cloudflare and you want its network in front. For SSH, its documentation has the connecting side run `cloudflared` or WARP.',
  },
  { h: 'Choose frp', t: 'if you need UDP or many proxy types today, configured in `frps` and `frpc` files. porthole has no UDP yet.' },
  { h: 'Choose sish', t: 'if the machine behind NAT should run nothing but plain `ssh -R`.' },
  {
    h: 'Choose porthole',
    t: 'if you want to run the server yourself and let an agent manage it over MCP, with automatic HTTPS per tunnel, one-time join links and SSH by name for visitors who have only OpenSSH.',
  },
];
const inline = (s: string) => s.split('`').map((p, i) => (i % 2 ? `<code>${p}</code>` : p)).join('');

const roadmap = [
  { v: 'v0.3', state: 'Done', h: 'Management by LLM agents', t: 'Admin API, MCP servers, join links, remote tunnel requests and a traffic inspector, instead of a web UI.' },
  { v: 'v0.4', state: 'Preview', h: 'Desktops', t: 'Windows and macOS clients, and porthole service for systemd, launchd and the Windows service manager.' },
  { v: 'v0.5', state: 'Planned', h: 'More transports and access control', t: 'QUIC, UDP and more HTTP access control.' },
];

const footer = [
  { label: 'Docs', href: doc('overview/') },
  { label: 'Quick start', href: doc('quickstart/') },
  { label: 'For AI assistants', href: doc('for-ai-assistants/') },
  { label: 'llms.txt', href: `${base}/llms.txt` },
  { label: 'GitHub', href: repoUrl },
  { label: 'Releases', href: `${repoUrl}/releases` },
  { label: 'Security', href: doc('security/') },
  { label: 'Contributing', href: doc('contributing/') },
  { label: 'Code of Conduct', href: `${repoUrl}/blob/main/CODE_OF_CONDUCT.md` },
  { label: 'License (Apache-2.0)', href: `${repoUrl}/blob/main/LICENSE` },
];
---

<div class="lp not-content">
  <div class="banner" id="lp-banner" role="region" aria-label="Announcement">
    <p>
      <strong>porthole is in alpha.</strong> v0.4 adds Windows and macOS clients, `porthole service` and `porthole doctor`.
      <a href={`${repoUrl}/releases`}>Read the release notes</a>
    </p>
    <button type="button" class="banner-close" aria-label="Dismiss the announcement" data-dismiss="lp-banner">&times;</button>
  </div>
  <script is:inline>
    try {
      if (localStorage.getItem('porthole-banner-v0.4') === '1') document.getElementById('lp-banner').hidden = true;
    } catch (e) {}
  </script>

  <nav class="mobile-nav" aria-label="Site">
    <a href={doc('overview/')}>Docs</a>
    <a href={doc('quickstart/')}>Quick start</a>
    <a href={repoUrl}>GitHub</a>
    <a href={`${repoUrl}/releases`}>Releases</a>
    <ThemeSelect />
  </nav>

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <p class="eyebrow">Open source &middot; self-hosted &middot; Apache-2.0</p>
        <h1 id="_top">Tunnels your AI agent can run.</h1>
        <p class="lead">
          Self-hosted ngrok alternative with an MCP server built in: ask your agent to expose a port, open SSH to a
          machine behind NAT, inspect traffic or onboard a new machine, on your own server.
        </p>
        <ul class="chips" aria-label="Highlights">
          {chips.map((c) => <li>{c}</li>)}
        </ul>
        <div class="cta">
          <a class="btn primary" href={doc('quickstart/')}>Quick start</a>
          <a class="btn" href={repoUrl}>
            <Icon name="github" size="1.1em" /> GitHub
          </a>
        </div>
        <p class="cmd-label">Paste into Claude Code or another coding agent:</p>
        <div class="cmd prompt">
          <code>{agentPrompt}</code>
          <button type="button" class="copy-btn" data-copy={agentPrompt} aria-label="Copy the install prompt for your agent">Copy</button>
        </div>
        <ul class="facts" aria-label="Facts">
          <li>Apache-2.0</li>
          <li><a href={`${repoUrl}/releases`}>{version}</a></li>
          <li>One static binary per side</li>
          <li>Signed releases (cosign)</li>
        </ul>
      </div>

      <div class="term" data-term>
        <div class="term-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title" data-term-title>{tabs[0].title}</span>
          <button type="button" class="copy-btn" data-copy-term aria-label="Copy the commands of this tab">Copy</button>
        </div>
        <div class="tabs" role="tablist" aria-label="Examples">
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`panel-${t.id}`}
                tabindex={i === 0 ? 0 : -1}
                data-title={t.title}
              >
                {t.label}
              </button>
            ))
          }
        </div>
        <div class="panels">
          {
            tabs.map((t, i) => (
              <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0}>
                <pre><code>{t.lines.map(([k, text]) => <span class={`l ${k}`}>{text}</span>)}</code></pre>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="agents" aria-labelledby="agents-h">
    <div class="wrap">
      <p class="kicker">For AI agents and Claude Code</p>
      <h2 id="agents-h">Managed by your LLM agent</h2>
      <p class="sub">
        porthole has no web UI. Instead it ships an MCP server, so Claude Code or any MCP client can operate the server
        and the tunnels of a machine, within the scopes you grant.
      </p>
      <div class="agents-grid">
        <ul class="points">
          {agentPoints.map((p) => <li><h3>{p.h}</h3><p set:html={inline(p.t)} /></li>)}
        </ul>
        <div>
          <div class="term small">
            <div class="term-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="term-title">connect Claude Code</span><button type="button" class="copy-btn" data-copy-term aria-label="Copy the commands">Copy</button></div>
            <pre><code><span class="l m"># on the server</span><span class="l c">sudo -u porthole portholed token create --name ops-agent --scopes admin:read,admin:tunnels,admin:remote,admin:tokens</span><span class="l c">claude mcp add --transport http porthole https://tun.example.com/_porthole/mcp \</span><span class="l k">--header "Authorization: Bearer ph_..."</span><span class="l b"></span><span class="l m"># on a client machine</span><span class="l c">claude mcp add porthole-local -- porthole mcp</span></code></pre>
          </div>
          <p class="tools-h">Operator tools</p>
          <ul class="toolchips">
            {tools.map((t) => <li><code>{t}</code></li>)}
          </ul>
          <p class="more"><a href={doc('agents/')}>All tools, toolsets and scopes</a> &middot; <a href={doc('for-ai-assistants/')}>Instructions for AI assistants</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" id="tunnels" aria-labelledby="tunnels-h">
    <div class="wrap">
      <p class="kicker">The tunnels themselves</p>
      <h2 id="tunnels-h">Expose localhost, reach machines behind NAT</h2>
      <p class="sub">Three ways to put a service on the internet, all through the server you run.</p>
      <div class="cards three">
        {
          capabilities.map((c) => (
            <article class="card">
              <h3>{c.h}</h3>
              <p set:html={inline(c.t)} />
              <pre class="mini"><code>{c.code}</code></pre>
              <a class="more" href={c.href}>Learn more &rarr;</a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="why" aria-labelledby="why-h">
    <div class="wrap">
      <p class="kicker">Why self-hosted</p>
      <h2 id="why-h">A self-hosted ngrok alternative you control</h2>
      <p class="sub">
        Hosted tunnel services run your traffic on their network, under their terms. porthole runs a tunnel from your
        own VPS instead.
      </p>
      <div class="cards six">
        {
          why.map((w) => (
            <a class="card link" href={w.href}>
              <h3>{w.h}</h3>
              <p>{w.t}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section alt" id="how" aria-labelledby="how-h">
    <div class="wrap">
      <p class="kicker">How it works</p>
      <h2 id="how-h">One outbound connection, many tunnels</h2>
      <figure class="diagram">
        <svg class="wide" viewBox="0 0 980 330" role="img" aria-labelledby="d1t d1d">
          <title id="d1t">porthole architecture</title>
          <desc id="d1d">Visitors reach portholed on your VPS over HTTPS, TCP or ssh -J. The porthole client behind NAT keeps one outbound TLS session to portholed and forwards streams to 127.0.0.1:3000, nas.local:5432 and 127.0.0.1:22.</desc>
          <defs>
            <marker id="ah" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="fill-line" /></marker>
          </defs>
          <rect x="590" y="22" width="380" height="288" rx="14" class="nat" />
          <text x="606" y="48" class="t-dim">behind NAT</text>
          <rect x="8" y="115" width="140" height="96" rx="10" class="box" />
          <text x="78" y="153" class="t-head" text-anchor="middle">visitors</text>
          <text x="78" y="178" class="t-dim" text-anchor="middle">browser, ssh, ...</text>
          <line x1="148" y1="163" x2="316" y2="163" class="line" marker-end="url(#ah)" />
          <text x="232" y="148" class="t-mono" text-anchor="middle">HTTPS / TCP / ssh -J</text>
          <rect x="316" y="105" width="190" height="116" rx="10" class="box accent" />
          <text x="411" y="148" class="t-head" text-anchor="middle">portholed</text>
          <text x="411" y="172" class="t-dim" text-anchor="middle">your VPS</text>
          <text x="411" y="196" class="t-mono" text-anchor="middle">tun.example.com</text>
          <line x1="626" y1="163" x2="508" y2="163" class="line thick" marker-end="url(#ah)" />
          <text x="567" y="132" class="t-mono" text-anchor="middle">one outbound</text>
          <text x="567" y="148" class="t-mono" text-anchor="middle">TLS session</text>
          <text x="567" y="196" class="t-dim" text-anchor="middle">many streams</text>
          <rect x="626" y="115" width="130" height="96" rx="10" class="box accent" />
          <text x="691" y="153" class="t-head" text-anchor="middle">porthole</text>
          <text x="691" y="178" class="t-dim" text-anchor="middle">the client</text>
          <path d="M756 163 H790 M790 78 V248 M790 78 H806 M790 163 H806 M790 248 H806" class="line" fill="none" />
          <rect x="806" y="56" width="150" height="44" rx="8" class="box" /><text x="881" y="83" class="t-mono" text-anchor="middle">127.0.0.1:3000</text>
          <rect x="806" y="141" width="150" height="44" rx="8" class="box" /><text x="881" y="168" class="t-mono" text-anchor="middle">nas.local:5432</text>
          <rect x="806" y="226" width="150" height="44" rx="8" class="box" /><text x="881" y="253" class="t-mono" text-anchor="middle">127.0.0.1:22</text>
        </svg>
        <svg class="tall" viewBox="0 0 320 560" role="img" aria-labelledby="d2t">
          <title id="d2t">porthole architecture (narrow layout)</title>
          <defs>
            <marker id="ah2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" class="fill-line" /></marker>
          </defs>
          <rect x="60" y="8" width="200" height="64" rx="10" class="box" />
          <text x="160" y="36" class="t-head" text-anchor="middle">visitors</text>
          <text x="160" y="58" class="t-dim" text-anchor="middle">browser, ssh, ...</text>
          <line x1="160" y1="72" x2="160" y2="124" class="line" marker-end="url(#ah2)" />
          <text x="172" y="103" class="t-mono">HTTPS / TCP / ssh -J</text>
          <rect x="60" y="124" width="200" height="82" rx="10" class="box accent" />
          <text x="160" y="152" class="t-head" text-anchor="middle">portholed</text>
          <text x="160" y="173" class="t-dim" text-anchor="middle">your VPS</text>
          <text x="160" y="194" class="t-mono" text-anchor="middle">tun.example.com</text>
          <rect x="8" y="238" width="304" height="314" rx="14" class="nat" />
          <text x="22" y="262" class="t-dim">behind NAT</text>
          <line x1="160" y1="276" x2="160" y2="208" class="line thick" marker-end="url(#ah2)" />
          <text x="172" y="236" class="t-mono">one outbound TLS session</text>
          <rect x="60" y="276" width="200" height="64" rx="10" class="box accent" />
          <text x="160" y="304" class="t-head" text-anchor="middle">porthole</text>
          <text x="160" y="326" class="t-dim" text-anchor="middle">the client</text>
          <path d="M160 340 V370 M60 370 H260 M60 370 V386 M160 370 V386 M260 370 V386" class="line" fill="none" />
          <rect x="22" y="386" width="86" height="56" rx="8" class="box" /><text x="65" y="410" class="t-mono2" text-anchor="middle">127.0.0.1</text><text x="65" y="428" class="t-mono2" text-anchor="middle">:3000</text>
          <rect x="117" y="386" width="86" height="56" rx="8" class="box" /><text x="160" y="410" class="t-mono2" text-anchor="middle">nas.local</text><text x="160" y="428" class="t-mono2" text-anchor="middle">:5432</text>
          <rect x="212" y="386" width="86" height="56" rx="8" class="box" /><text x="255" y="410" class="t-mono2" text-anchor="middle">127.0.0.1</text><text x="255" y="428" class="t-mono2" text-anchor="middle">:22</text>
        </svg>
      </figure>
      <p class="prose">
        The client opens one outbound WebSocket-over-TLS session to <code>portholed</code> and multiplexes everything over
        it (yamux). There is one control stream (login, tunnel registration, heartbeats) and one data stream per visitor
        connection, opened by the server. The client never interprets proxied bytes: for each data stream it dials the
        local target and copies bytes both ways. HTTP routing by <code>Host</code>, TLS and WebSocket upgrades all live on
        the server. <a href={doc('design/')}>Design</a> &middot; <a href={doc('protocol/')}>Wire protocol</a>
      </p>
    </div>
  </section>

  <section class="section" id="inspector" aria-labelledby="insp-h">
    <div class="wrap two">
      <div>
        <p class="kicker">Traffic log and inspector</p>
        <h2 id="insp-h">See what hit your webhook</h2>
        <p class="sub left">
          The server terminates TLS for HTTP tunnels, so it records every proxied request in memory. Nothing is written
          to disk. You or your agent can search the log and replay a request.
        </p>
        <ul class="plain">
          <li>Each entry has the time, tunnel, visitor IP, method, host, path, masked query, status, latency, body bytes and user agent.</li>
          <li>Start a tunnel with <code>porthole http --inspect</code> to also keep request and response headers and bodies, up to 64 KiB each. <code>Authorization</code> and cookies are always stored as <code>REDACTED</code>.</li>
          <li>Replay a recorded request into its tunnel with <code>replay_request</code>.</li>
        </ul>
        <p class="more"><a href={doc('server/#request-log-and-inspection')}>Request log and inspection</a></p>
      </div>
      <div class="term small">
        <div class="term-bar"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="term-title">claude: porthole</span></div>
        <pre><code><span class="l u">what hit my webhook in the last 10 minutes?</span><span class="l a">query_requests {'{'}tunnel: "hooks", since: "10m"{'}'}</span><span class="l u">show me the failed one</span><span class="l a">query_requests {'{'}tunnel: "hooks", status_class: 5{'}'}</span><span class="l a">get_request {'{'}id: "..."{'}'}</span><span class="l u">replay it against my dev server</span><span class="l a">replay_request {'{'}id: "..."{'}'}</span></code></pre>
      </div>
    </div>
  </section>

  <section class="section alt" id="compare" aria-labelledby="cmp-h">
    <div class="wrap">
      <p class="kicker">Comparison</p>
