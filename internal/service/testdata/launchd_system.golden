<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.eto-a.porthole</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/porthole</string>
		<string>daemon</string>
		<string>--config</string>
		<string>/Library/Application Support/porthole/config.yaml</string>
		<string>--tunnels</string>
		<string>/Library/Application Support/porthole/tunnels.yaml</string>
		<string>--socket</string>
		<string>/var/run/porthole/porthole.sock</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/Library/Logs/porthole/porthole.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/porthole/porthole.err.log</string>
</dict>
</plist>
